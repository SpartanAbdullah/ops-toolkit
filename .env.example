# --- Supabase Auth & Database ---
# Pooled connection used by the app at runtime (Supavisor / PgBouncer)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Direct, unpooled connection used by `prisma migrate` (required for migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Either of these is accepted — _PUBLISHABLE_DEFAULT_KEY wins if both are set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-publishable-key"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Public origin of the deployed app (used by metadata/sitemap; trailing slash optional)
NEXT_PUBLIC_SITE_URL="https://opstoolkit.app"

# SaaS default: public signup is available, but users must create or join a workspace
# before accessing petty cash or overtime records.
NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP="true"
